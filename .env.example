# Copy this file to .env and replace every placeholder. Never commit .env.
TGHARBOR_TELEGRAM_API_ID=123456
TGHARBOR_TELEGRAM_API_HASH=replace-with-api-hash
TGHARBOR_TELEGRAM_BOT_TOKEN=replace-with-bot-token
TGHARBOR_TELEGRAM_PHONE=+12025550123
TGHARBOR_TELEGRAM_AUTHORIZED_USERS=123456789

# Match the owner of /data/tgharbor/data and /data/tgharbor/downloads on Linux.
# Run `id -u` and `id -g` for the deployment account.
TGHARBOR_UID=1000
TGHARBOR_GID=1000
